# SportHouse — local env. Copy to .env.local and fill in. (.env.local is gitignored.)

# ── Supabase (Phase 1 persistence) ──────────────────────────────────────────────
# From Supabase → Project Settings → API. NEXT_PUBLIC_ is correct here: the anon key
# is designed to be public; row-level security is what protects the data. (Unlike the
# Anthropic key below, which must stay server-side only.)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Auth (Phase 2) ───────────────────────────────────────────────────────────────
# OPTIONAL — not required for this PR. Auth redirect URLs (magic-link + OAuth) are
# built from window.location.origin on the client and from the request host in
# /auth/callback, so the same code works on localhost / preview / prod with NO env var.
# Only set this if you later need SERVER-built absolute URLs; if so, add it to
# .env.local AND to Vercel (Production + Preview):
# NEXT_PUBLIC_SITE_URL=https://your-prod-domain
#
# NOTE: Google OAuth client id/secret are configured in the SUPABASE dashboard
# (Auth → Providers → Google), NOT here. No app-side OAuth secret is introduced.
# NOTE: production magic-link delivery needs custom SMTP configured in Supabase —
# the built-in email service is rate-limited and not for production.

# ── Supabase admin — SERVER-SIDE ONLY, never NEXT_PUBLIC_ ──────────────────────
# From Supabase → Project Settings → API → service_role key.
# Used server-side only: warm-cache upserts previews; getDistinctFollowedTeamIds reads prefs.
SUPABASE_SERVICE_ROLE_KEY=

# ── Ollama (local AI preview generation) ─────────────────────────────────────
# URL of the local Ollama instance. Only needed on the Mac running warm-cache.sh.
# NOT required on Vercel — the deployed app reads previews from Supabase, not Ollama.
OLLAMA_HOST=http://localhost:11434/v1
# Optional model override:
# OLLAMA_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M

# ── Cron secret (warm-cache auth) — SERVER-SIDE ONLY ─────────────────────────
# Shared secret between warm-cache.sh and /api/ai-preview + /api/cron/warm-cache.
# Generate with: openssl rand -hex 16
CRON_SECRET=

# ── Anthropic — DEV ONLY (eval harness scripts/eval-previews.ts) ─────────────────
# NOT in the live runtime path: previews/reviews are generated by local Ollama via
# the `openai` SDK (used purely as the Ollama OpenAI-compatible transport). Only the
# dev eval harness uses the Anthropic SDK. Kept for evaluation/comparison.
ANTHROPIC_API_KEY=
# Optional model override (defaults to Claude Haiku 4.5):
# ANTHROPIC_AI_MODEL=claude-haiku-4-5-20251001

# ── Cricket data (BBL + internationals) — SERVER-SIDE ONLY ───────────────────────
# REQUIRED for cricket fixtures/previews. From cricketdata.org / CricAPI.
# Free tier = 100 hits/DAY (process-cached + circuit-broken). Cricket is silently
# dormant without this key.
CRICKETDATA_API_KEY=

# ── AI review auth (SEC-1) ───────────────────────────────────────────────────────
# Optional. Default (unset/false) keeps /api/ai-review usable by any session
# (anonymous included). Set to "true" to require a NON-anonymous (signed-in) session.
# REQUIRE_AUTH_FOR_AI_REVIEW=true

# ── Optional / dev-only ──────────────────────────────────────────────────────────
# NEXT_PUBLIC_SITE_URL — only for SERVER-built absolute URLs (the cron poller's
# self-call to /api/ai-review). Must be https or loopback in prod (SEC-3). Client
# auth redirects don't need it.
# NEXT_PUBLIC_SITE_URL=https://your-prod-domain
#
# SANDBOX_BASE — base URL the dev prompt-sandbox scripts hit (default localhost:3001).
# SANDBOX_BASE=http://localhost:3001
#
# EVAL_SAMPLES — sample count for scripts/eval-previews.ts (dev eval harness).
# EVAL_SAMPLES=20
