# Next.js build output
.next/
out/

# Dependencies
node_modules/

# Environment — ignore ALL .env variants (incl. .save/.backup), but keep examples.
.env
.env.*
!.env.local.example
!.env.*.example

# Secrets — never commit downloaded OAuth client secrets (Google Cloud Console).
# These belong ONLY in the Supabase dashboard (Auth → Providers → Google), not the repo.
client_secret_*.json
*.apps.googleusercontent.com.json

# Editor
.claude/

# TypeScript incremental build cache
*.tsbuildinfo

# Generated eval artifacts (scripts/eval-previews.ts)
eval-output/
.DS_Store
.env.local.save
*.save
