<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent — generates AI match previews every hour via Ollama.

  REQUIREMENTS:
    - The Mac must stay on and Ollama must be running.
    - .env.local must exist at the project root with SUPABASE_SERVICE_ROLE_KEY,
      NEXT_PUBLIC_SUPABASE_URL, OLLAMA_HOST, and CRON_SECRET set.
    - Node.js is managed via nvm; the ProgramArguments loads it directly from
      ~/.nvm/nvm.sh so PATH is correct even in launchd's minimal environment.

  INSTALL:
    1. Copy this file to ~/Library/LaunchAgents/:
         cp scripts/launchd/com.sporthouse.previews.plist ~/Library/LaunchAgents/

    2. If previously loaded, unload first:
         launchctl bootout gui/$(id -u)/com.sporthouse.previews 2>/dev/null

    3. Load it (runs immediately via RunAtLoad, then every hour):
         launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.sporthouse.previews.plist

  VERIFY:
    launchctl list | grep sporthouse
    # Should show: -  0  com.sporthouse.previews  (0 = clean exit)

    tail -f /tmp/sporthouse-previews.log   # launch output + summary line
    tail -f /tmp/sporthouse-ai.log         # per-generation detail

  UNLOAD:
    launchctl bootout gui/$(id -u)/com.sporthouse.previews

  TROUBLESHOOT:
    LastExitCode 127 = npm/node not found.
      Run: source ~/.nvm/nvm.sh && which npm
      If that fails, update the NVM_DIR path in ProgramArguments below to match
      the output of: echo $NVM_DIR
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sporthouse.previews</string>

  <!--
    Load nvm directly (not via .zprofile/.zshrc — those are for interactive
    shells; launchd gets a minimal bash environment with no shell profile).
    Falls back to the known absolute nvm node path if nvm.sh is missing.
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>export NVM_DIR="$HOME/.nvm"; [ -s "$NVM_DIR/nvm.sh" ] &amp;&amp; source "$NVM_DIR/nvm.sh" || export PATH="/Users/andreasjenkins/.nvm/versions/node/v20.20.2/bin:$PATH"; cd /Users/andreasjenkins/Documents/SportHouse &amp;&amp; npm run warm</string>
  </array>

  <!-- Fire every hour. -->
  <key>StartInterval</key>
  <integer>3600</integer>

  <key>WorkingDirectory</key>
  <string>/Users/andreasjenkins/Documents/SportHouse</string>

  <!-- Run once immediately on load, then on the interval. -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Both stdout and stderr land in the same log file for easy tailing. -->
  <key>StandardOutPath</key>
  <string>/tmp/sporthouse-previews.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/sporthouse-previews.log</string>

  <!-- Restart after a crash, but don't hammer — wait 60 s. -->
  <key>ThrottleInterval</key>
  <integer>60</integer>
</dict>
</plist>
